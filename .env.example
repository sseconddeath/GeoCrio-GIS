# Скопировать в .env.local (для локальной разработки) и заполнить реальными
# значениями из Supabase Dashboard → Project Settings → API.

# Публичные — попадают в клиентский бандл, значения не секретны.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Секретный — используется только в серверных API routes / server actions.
# Никогда не префиксовать NEXT_PUBLIC_, никогда не коммитить реальное значение.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Генерируются один раз командой:
#   npx web-push generate-vapid-keys
# Публичный ключ уезжает в клиентский бандл (без него кнопка «Включить
# уведомления» деактивирована). Приватный — только сервер. VAPID_SUBJECT
# — mailto:<адрес> контактный, требуется спецификацией.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
